# Copy to .env before setup. Explicit environment variables take precedence.
# Exact browser-visible origin, with no trailing slash.
APP_ORIGIN=http://127.0.0.1:5173
# Public installations: HTTPS is required, including tunnel URLs or IP origins.
# APP_ORIGIN=https://spaces.example.com
APP_DATA_DIR=.data
# Keep the application behind a TLS proxy/tunnel; do not expose this port publicly.
HOST=127.0.0.1
PORT=5173
# Owner email/password are set with npm run setup, never in this file.

# Recommended for public installations: avoid recording prompts and app data in logs.
# APP_DIAGNOSTICS=off

# Optional contact for automatically generated Web Push VAPID keys
# VAPID_SUBJECT=mailto:you@example.com

# Optional overrides after npm run voice:setup (absolute paths recommended for VPS services)
# PIPER_PYTHON=/srv/little-spaces/.tools/piper/bin/python
# PIPER_MODEL=/srv/little-spaces/.tools/piper-voices/en_US-lessac-medium.onnx
