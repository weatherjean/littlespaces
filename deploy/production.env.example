LITTLESPACES_PUBLIC_URL=https://apps.example.com
LITTLESPACES_OAUTH_CALLBACK=http://127.0.0.1:1455/auth/callback
# Only enable behind the bundled loopback proxy, which overwrites X-Real-IP.
LITTLESPACES_TRUST_PROXY=1
LITTLESPACES_BROWSER_HARNESS=http://127.0.0.1:5176
LITTLESPACES_BROWSER_PORT=5176
# Replace with a randomly generated token of at least 32 characters.
LITTLESPACES_BROWSER_TOKEN=REPLACE_WITH_RANDOM_TOKEN
VAPID_SUBJECT=mailto:operator@example.com
