{
  "name": "little-spaces",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:instance": "node scripts/dev-instance.mjs",
    "dev:eval": "node scripts/dev-eval.mjs",
    "build": "vite build",
    "preview": "node scripts/start.mjs",
    "start": "node scripts/start.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "logs": "node scripts/logs.mjs",
    "deploy:local": "node scripts/deploy-local.mjs",
    "setup": "node scripts/setup.mjs",
    "voice:setup": "node scripts/setup-voice.mjs",
    "owner:reset": "node scripts/setup.mjs --reset",
    "test:http": "tsx --test tests/http/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check && npm test && npm run build && npm run test:http",
    "icons": "node scripts/generate-icons.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui",
    "build:rust:web": "node scripts/migration/build-web.mjs",
    "start:rust": "node scripts/migration/start.mjs",
    "test:rust": "cargo test --manifest-path rust/Cargo.toml",
    "test:rust:e2e": "node scripts/migration/test-browser.mjs",
    "dev:legacy": "node scripts/dev.mjs",
    "build:legacy": "vite build",
    "start:legacy": "node scripts/start.mjs",
    "dev:rust": "node scripts/migration/dev.mjs",
    "build:rust": "npm run build:rust:web && cargo build --manifest-path rust/Cargo.toml --release --locked",
    "check:rust:web": "node scripts/migration/check-web.mjs",
    "check:rust": "npm run check:rust:web && cargo clippy --manifest-path rust/Cargo.toml --locked -- -D warnings",
    "setup:rust": "node scripts/migration/start.mjs --setup-owner",
    "owner:reset:rust": "node scripts/migration/start.mjs --reset-owner",
    "import:rust": "node scripts/migration/start.mjs --import-workspace",
    "verify:rust": "npm run check:rust && npm run test:rust && npm run build:rust:web && cargo build --manifest-path rust/Cargo.toml --locked && npm run test:rust:e2e"
  },
  "dependencies": {
    "@openai/codex": "0.160.0",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.20.0",
    "@tailwindcss/node": "^4.3.3",
    "@tailwindcss/oxide": "^4.3.3",
    "ajv": "^8.20.0",
    "cron-parser": "^5.10.1",
    "esbuild": "^0.25.0",
    "htm": "^3.1.1",
    "jose": "^6.0.0",
    "preact": "^10.29.8",
    "sharp": "^0.35.5",
    "svelte": "^5.25.0",
    "tailwindcss": "^4.3.3",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/web-push": "^3.6.4",
    "eslint": "^9.39.5",
    "globals": "^17.13.0",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  }
}
