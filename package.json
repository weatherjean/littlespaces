{
  "name": "little-spaces",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build",
    "preview": "node scripts/start.mjs",
    "start": "node scripts/start.mjs",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "test": "tsx --test tests/*.test.ts",
    "logs": "node scripts/logs.mjs",
    "deploy:local": "node scripts/deploy-local.mjs",
    "setup": "node scripts/setup.mjs",
    "voice:setup": "node scripts/setup-voice.mjs",
    "owner:reset": "node scripts/setup.mjs --reset",
    "test:http": "tsx --test tests/http/*.test.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "verify": "npm run format:check && npm run check && npm test && npm run build && npm run test:http",
    "icons": "node scripts/generate-icons.mjs",
    "test:e2e": "npm run build && playwright test",
    "test:e2e:ui": "npm run build && playwright test --ui"
  },
  "dependencies": {
    "@openai/codex": "0.160.0",
    "@sveltejs/adapter-node": "^5.2.0",
    "@sveltejs/kit": "^2.20.0",
    "ajv": "^8.20.0",
    "cron-parser": "^5.10.1",
    "esbuild": "^0.25.0",
    "jose": "^6.0.0",
    "sharp": "^0.35.5",
    "svelte": "^5.25.0",
    "web-push": "^3.6.7"
  },
  "overrides": {
    "@sveltejs/kit": {
      "cookie": "^0.7.2"
    }
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^5.0.0",
    "@types/node": "^22.13.0",
    "@types/web-push": "^3.6.4",
    "prettier": "3.9.9",
    "prettier-plugin-svelte": "4.1.1",
    "svelte-check": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.7.0",
    "vite": "^6.2.0"
  }
}
